generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  MODERATOR
  ADMIN
}


enum AdminPermissionKey {
  USERS_VIEW
  USERS_EDIT
  USERS_SECURITY
  USERS_BULK
  CONTENT_VIEW
  CONTENT_MODERATE
  CONTENT_METRICS
  MESSAGES_VIEW
  REPORTS_MANAGE
  VERIFICATION_MANAGE
  ANALYTICS_VIEW
  AUDIT_VIEW
  AUDIT_EXPORT
  PLATFORM_SETTINGS
  FEATURE_FLAGS
  ANNOUNCEMENTS
  STORAGE_VIEW
  STORAGE_MANAGE
  SECURITY_MANAGE
  ADMIN_MANAGE
  PRIVACY_OPERATIONS
  CASES_MANAGE
  ENFORCEMENT_MANAGE
  RISK_VIEW
  APPROVALS_MANAGE
  DATA_INTEGRITY
  RATE_LIMITS_VIEW
  DEVICE_MANAGEMENT
}

enum PostVisibility {
  PUBLIC
  FRIENDS
  PRIVATE
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum ConversationRole {
  MEMBER
  ADMIN
}

enum NotificationType {
  LIKE
  COMMENT
  FOLLOW
  FRIEND_REQUEST
  FRIEND_ACCEPTED
  MESSAGE
  MENTION
  SHARE
  SYSTEM
  STORY_REPLY
  STORY_REACTION
}

enum StoryAudience {
  PUBLIC
  FRIENDS
}

enum ReportStatus {
  PENDING
  REVIEWED
  RESOLVED
  DISMISSED
}

enum ReportPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean
  image         String?
  createdAt     DateTime
  updatedAt     DateTime

  username      String?   @unique
  bio           String?
  coverImage    String?
  website       String?
  location      String?
  role          UserRole  @default(USER)
  isPrivate     Boolean   @default(false)
  isActive      Boolean   @default(true)
  isVerified    Boolean   @default(false)
  verifiedAt    DateTime?
  isOwner       Boolean   @default(false)
  ownerSince    DateTime?
  suspensionReason String?
  suspendedUntil DateTime?
  postingRestrictedUntil DateTime?
  commentingRestrictedUntil DateTime?
  messagingRestrictedUntil DateTime?
  socialRestrictedUntil DateTime?
  deletedAt DateTime?
  forcePasswordResetAt DateTime?
  twoFactorEnabled Boolean @default(false)

  sessions      Session[]
  accounts      Account[]

  posts         Post[]
  comments      Comment[]
  likes         Like[]
  postReactions PostReaction[]
  uploadUsages UploadUsage[]
  followers     Follow[]          @relation("UserFollowers")
  following     Follow[]          @relation("UserFollowing")
  sentMessages  Message[]         @relation("MessageSender")
  memberships   ConversationMember[]
  notifications Notification[]    @relation("NotificationRecipient")
  actedNotifications Notification[] @relation("NotificationActor")
  notificationPreference NotificationPreference?
  privacySetting UserPrivacySetting?
  stories       Story[]
  storyViews    StoryView[]
  storyReplies  StoryReply[]
  storyReactions StoryReaction[]
  messageAttachments MessageAttachment[] @relation("MessageAttachmentSender")
  messageReactions MessageReaction[] @relation("MessageReactionUser")
  savedPosts    SavedPost[]
  sentFriendRequests FriendRequest[] @relation("FriendRequestSender")
  receivedFriendRequests FriendRequest[] @relation("FriendRequestReceiver")
  filedReports  Report[]           @relation("ReportReporter")
  reportedIn    Report[]           @relation("ReportTargetUser")
  resolvedReports Report[]         @relation("ReportResolver")
  assignedReports Report[]         @relation("ReportAssignee")
  blockedUsers  Block[]            @relation("Blocker")
  blockedBy     Block[]            @relation("Blocked")
  mutesGiven    Mute[]             @relation("MutesGiven")
  mutedBy       Mute[]             @relation("MutedBy")
  verificationAudits VerificationAudit[] @relation("VerificationTarget")
  performedVerificationAudits VerificationAudit[] @relation("VerificationAdmin")
  verificationRequests VerificationRequest[] @relation("VerificationRequester")
  reviewedVerificationRequests VerificationRequest[] @relation("VerificationReviewer")
  adminPermissions AdminPermission[] @relation("AdminPermissionUser")
  createdAnnouncements Announcement[] @relation("AnnouncementCreator")
  changedFeatureFlags FeatureFlag[] @relation("FeatureFlagChanger")
  changedSystemSettings SystemSetting[] @relation("SystemSettingChanger")
  twoFactor TwoFactor?
  adminMetricOverride AdminMetricOverride?
  profileViewsReceived ProfileView[] @relation("ProfileViewProfile")
  profileViewsMade ProfileView[] @relation("ProfileViewViewer")
  adminAuditLogs AdminAuditLog[] @relation("AdminAuditActor")
  managedDevices ManagedDevice[] @relation("DeviceOwner")
  devicePolicyChanges DevicePolicy[] @relation("DevicePolicyActor")
  deviceManagementAudits DeviceManagementAudit[] @relation("DeviceManagementAuditActor")

  @@index([createdAt])
  @@index([role])
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String   @id
  accountId             String
  providerId            String
  userId                String
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@index([identifier])
  @@map("verification")
}

model Post {
  id         String         @id @default(cuid())
  authorId   String
  content    String?
  mediaUrl   String?
  visibility PostVisibility @default(PUBLIC)
  shareCount Int            @default(0)
  isPinned   Boolean         @default(false)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  author     User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comments   Comment[]
  likes      Like[]
  postReactions PostReaction[]
  savedBy    SavedPost[]
  notifications Notification[]
  reports    Report[]
  postMetricOverride AdminPostMetricOverride?

  @@index([authorId, isPinned, createdAt])
  @@index([visibility, createdAt])
  @@index([createdAt, id])
}

model Comment {
  id        String    @id @default(cuid())
  postId    String
  authorId  String
  parentId  String?
  content   String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  post      Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  author    User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent    Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[] @relation("CommentReplies")
  notifications Notification[]
  reports   Report[]

  @@index([postId, createdAt])
  @@index([authorId, createdAt])
  @@index([parentId])
}

model Like {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())

  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([userId])
}

model Follow {
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower   User @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  following  User @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
  @@index([followingId, createdAt])
}

model FriendRequest {
  id          String           @id @default(cuid())
  senderId    String
  receiverId  String
  status      FriendshipStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  sender      User @relation("FriendRequestSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver    User @relation("FriendRequestReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([senderId, receiverId])
  @@index([receiverId, status])
  @@index([senderId, status])
  @@index([receiverId, updatedAt])
}

model Conversation {
  id        String                 @id @default(cuid())
  title     String?
  isGroup   Boolean                @default(false)
  directKey  String?               @unique
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt

  members   ConversationMember[]
  messages  Message[]

  @@index([updatedAt])
}

model ConversationMember {
  id             String             @id @default(cuid())
  conversationId String
  userId         String
  role           ConversationRole   @default(MEMBER)
  joinedAt       DateTime           @default(now())
  lastReadAt     DateTime?
  mutedUntil     DateTime?
  archivedAt     DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId, lastReadAt])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  senderId       String
  content        String
  createdAt      DateTime     @default(now())
  editedAt       DateTime?
  deletedAt      DateTime?
  replyToId      String?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  notifications Notification[]
  attachments MessageAttachment[]
  reactions MessageReaction[]
  replyTo Message? @relation("MessageReply", fields: [replyToId], references: [id], onDelete: SetNull)
  replies Message[] @relation("MessageReply")

  @@index([conversationId, createdAt])
  @@index([conversationId, createdAt, id])
  @@index([senderId, createdAt])
  @@index([replyToId])
}

model MessageAttachment {
  id        String   @id @default(cuid())
  messageId String
  senderId  String
  url       String
  kind      String   @default("image")
  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  sender  User    @relation("MessageAttachmentSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([messageId, createdAt])
}

model MessageReaction {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation("MessageReactionUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([messageId, createdAt])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  actorId   String?
  type      NotificationType
  postId    String?
  commentId String?
  messageId String?
  storyId   String?
  title     String?
  body      String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user      User        @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  actor     User?       @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  post      Post?       @relation(fields: [postId], references: [id], onDelete: Cascade)
  comment   Comment?    @relation(fields: [commentId], references: [id], onDelete: Cascade)
  message   Message?    @relation(fields: [messageId], references: [id], onDelete: Cascade)
  story     Story?      @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@index([actorId, createdAt])
  @@index([storyId])
}

model UserPrivacySetting {
  id                    String   @id @default(cuid())
  userId                String   @unique
  showFriendsList       Boolean  @default(true)
  showFollowersList     Boolean  @default(true)
  showFollowingList     Boolean  @default(true)
  allowMessagesEveryone Boolean  @default(true)
  allowFriendRequests   Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model NotificationPreference {
  id               String   @id @default(cuid())
  userId           String   @unique
  likes            Boolean  @default(true)
  comments         Boolean  @default(true)
  follows          Boolean  @default(true)
  friendRequests   Boolean  @default(true)
  friendAccepted   Boolean  @default(true)
  messages         Boolean  @default(true)
  mentions         Boolean  @default(true)
  shares           Boolean  @default(true)
  system           Boolean  @default(true)
  storyReplies     Boolean  @default(true)
  storyReactions   Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Story {
  id         String         @id @default(cuid())
  authorId   String
  mediaUrl   String
  mediaType  String         @default("IMAGE")
  caption    String?
  audience   StoryAudience  @default(PUBLIC)
  expiresAt  DateTime
  createdAt  DateTime       @default(now())

  author     User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  views      StoryView[]
  replies    StoryReply[]
  reactions  StoryReaction[]
  notifications Notification[]

  @@index([authorId, expiresAt])
  @@index([expiresAt, audience])
}

model StoryView {
  id        String   @id @default(cuid())
  storyId   String
  viewerId  String
  viewedAt  DateTime @default(now())

  story  Story @relation(fields: [storyId], references: [id], onDelete: Cascade)
  viewer User  @relation(fields: [viewerId], references: [id], onDelete: Cascade)

  @@unique([storyId, viewerId])
  @@index([viewerId, viewedAt])
}

model SavedPost {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([userId, createdAt])
}

model Report {
  id             String       @id @default(cuid())
  reporterId     String
  postId         String?
  commentId      String?
  reportedUserId String?
  reason         String
  status         ReportStatus @default(PENDING)
  priority       ReportPriority @default(MEDIUM)
  assignedToId   String?
  moderatorNote  String?
  createdAt      DateTime     @default(now())
  resolvedAt     DateTime?
  resolvedById   String?

  reporter     User      @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  post         Post?     @relation(fields: [postId], references: [id], onDelete: Cascade)
  comment      Comment?  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  reportedUser User?     @relation("ReportTargetUser", fields: [reportedUserId], references: [id], onDelete: SetNull)
  resolvedBy   User?     @relation("ReportResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  assignedTo   User?     @relation("ReportAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([reporterId, createdAt])
  @@index([reportedUserId, createdAt])
  @@index([assignedToId, status, priority, createdAt])
}

model Block {
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@index([blockedId])
}


model Mute {
  muterId   String
  mutedId   String
  createdAt DateTime @default(now())

  muter User @relation("MutesGiven", fields: [muterId], references: [id], onDelete: Cascade)
  muted User @relation("MutedBy", fields: [mutedId], references: [id], onDelete: Cascade)

  @@id([muterId, mutedId])
  @@index([muterId, createdAt])
  @@index([mutedId, createdAt])
}


model AdminPostMetricOverride {
  id        String   @id @default(cuid())
  postId    String   @unique
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  likes     Int?
  comments  Int?
  shares    Int?
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@index([updatedAt])
}

model AdminMetricOverride {
  id              String   @id @default(cuid())
  userId          String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  followers       Int?
  following       Int?
  posts           Int?
  likesReceived   Int?
  commentsReceived Int?
  shares          Int?
  profileViews    Int?
  updatedAt       DateTime @updatedAt
  createdAt       DateTime @default(now())

  @@index([updatedAt])
}

model AdminAuditLog {
  id          String   @id @default(cuid())
  adminId     String
  admin       User   @relation("AdminAuditActor", fields: [adminId], references: [id], onDelete: Cascade)
  action      String
  targetType  String
  targetId    String?
  details     String?
  createdAt   DateTime @default(now())

  @@index([adminId, createdAt])
  @@index([targetType, targetId, createdAt])
}


model StoryReply {
  id        String   @id @default(cuid())
  storyId   String
  authorId  String
  content   String
  createdAt DateTime @default(now())

  story  Story @relation(fields: [storyId], references: [id], onDelete: Cascade)
  author User  @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([storyId, createdAt])
  @@index([authorId, createdAt])
}

model StoryReaction {
  id        String   @id @default(cuid())
  storyId   String
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  story Story @relation(fields: [storyId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([storyId, userId])
  @@index([storyId, createdAt])
  @@index([userId, createdAt])
}


model PostReaction {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([postId, emoji, createdAt])
  @@index([userId, createdAt])
}


model AdminLoginAttempt {
  id        String   @id @default(cuid())
  key       String   @unique
  count     Int      @default(0)
  resetAt   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([resetAt])
}


enum VerificationAuditAction {
  GRANTED
  REVOKED
  OWNER_GRANTED
  OWNER_REVOKED
  REQUEST_APPROVED
  REQUEST_REJECTED
}

model VerificationAudit {
  id        String                 @id @default(cuid())
  userId    String
  adminId   String?
  action    VerificationAuditAction
  reason    String?
  createdAt DateTime               @default(now())

  user  User @relation("VerificationTarget", fields: [userId], references: [id], onDelete: Cascade)
  admin User? @relation("VerificationAdmin", fields: [adminId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([adminId, createdAt])
}

enum VerificationRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model VerificationRequest {
  id         String                   @id @default(cuid())
  userId     String
  reviewerId String?
  status     VerificationRequestStatus @default(PENDING)
  reason     String?
  adminNote  String?
  createdAt  DateTime                 @default(now())
  reviewedAt DateTime?
  updatedAt  DateTime                 @updatedAt

  user     User  @relation("VerificationRequester", fields: [userId], references: [id], onDelete: Cascade)
  reviewer User? @relation("VerificationReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([userId, status, createdAt])
  @@index([status, createdAt])
}


model UploadUsage {
  id        String   @id @default(cuid())
  userId    String
  bytes     Int
  url       String?
  pathname  String?
  mimeType  String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([createdAt, bytes])
}


model AdminPermission {
  id         String             @id @default(cuid())
  adminId    String
  permission AdminPermissionKey
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  admin      User               @relation("AdminPermissionUser", fields: [adminId], references: [id], onDelete: Cascade)
  @@unique([adminId, permission])
  @@index([permission])
}

model SystemSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  updatedBy   User?    @relation("SystemSettingChanger", fields: [updatedById], references: [id], onDelete: SetNull)
  @@index([updatedById])
}

model FeatureFlag {
  id          String   @id @default(cuid())
  key         String   @unique
  enabled     Boolean  @default(false)
  description String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  updatedBy   User?    @relation("FeatureFlagChanger", fields: [updatedById], references: [id], onDelete: SetNull)
  @@index([updatedById])
}

model Announcement {
  id          String   @id @default(cuid())
  title       String
  body        String
  audience    String   @default("ALL")
  status      String   @default("DRAFT")
  startsAt    DateTime?
  endsAt      DateTime?
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   User     @relation("AnnouncementCreator", fields: [createdById], references: [id], onDelete: Cascade)
  @@index([status, startsAt])
  @@index([createdById, createdAt])
}


model ProfileView {
  id        String   @id @default(cuid())
  profileId String
  viewerId  String?
  viewedAt  DateTime @default(now())

  profile User @relation("ProfileViewProfile", fields: [profileId], references: [id], onDelete: Cascade)
  viewer  User? @relation("ProfileViewViewer", fields: [viewerId], references: [id], onDelete: SetNull)

  @@index([profileId, viewedAt])
  @@index([viewerId, viewedAt])
}

model RateLimitBucket {
  id        String   @id @default(cuid())
  key       String   @unique
  count     Int      @default(0)
  resetAt   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([resetAt])
}

model TwoFactor {
  id String @id
  userId String @unique
  secret String
  backupCodes String
  verified Boolean @default(false)
  failedVerificationCount Int @default(0)
  lockedUntil DateTime?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}


model AdminCase {
  id              String   @id @default(cuid())
  title           String
  category        String   @default("OTHER")
  status          String   @default("OPEN")
  priority        String   @default("MEDIUM")
  subjectUserId   String?
  postId          String?
  commentId       String?
  conversationId  String?
  assignedToId    String?
  createdById     String
  reason          String?
  resolution      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  resolvedAt      DateTime?

  @@index([status, priority, createdAt])
  @@index([subjectUserId, createdAt])
  @@index([assignedToId, status, priority])
}

model AdminCaseEvent {
  id          String   @id @default(cuid())
  caseId      String
  actorId     String?
  type        String
  details     String?
  createdAt   DateTime @default(now())

  @@index([caseId, createdAt])
  @@index([actorId, createdAt])
}

model AdminEnforcementAction {
  id            String   @id @default(cuid())
  subjectUserId String
  actorId       String
  caseId        String?
  action        String
  reason        String
  expiresAt     DateTime?
  reversedAt    DateTime?
  metadata      String?
  createdAt     DateTime @default(now())

  @@index([subjectUserId, createdAt])
  @@index([caseId, createdAt])
  @@index([action, createdAt])
}

model AdminRiskSignal {
  id            String   @id @default(cuid())
  userId        String
  kind          String
  score         Int
  details       String?
  detectedAt    DateTime @default(now())
  resolvedAt    DateTime?

  @@index([userId, detectedAt])
  @@index([score, detectedAt])
  @@index([resolvedAt, detectedAt])
}

model AdminAppeal {
  id            String   @id @default(cuid())
  userId        String
  caseId        String?
  reason        String
  evidence      String?
  status        String   @default("PENDING")
  reviewerId    String?
  reviewerNote  String?
  createdAt     DateTime @default(now())
  reviewedAt    DateTime?

  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@index([caseId, createdAt])
}

model AdminApprovalRequest {
  id            String   @id @default(cuid())
  requesterId   String
  approverId    String?
  action        String
  targetType    String
  targetId      String
  payload       String?
  reason        String
  status        String   @default("PENDING")
  createdAt     DateTime @default(now())
  decidedAt     DateTime?
  decisionNote  String?

  @@index([status, createdAt])
  @@index([requesterId, createdAt])
  @@index([targetType, targetId])
}

model AdminFlagChange {
  id          String   @id @default(cuid())
  flagKey     String
  actorId     String
  before      Boolean
  after       Boolean
  reason      String?
  createdAt   DateTime @default(now())

  @@index([flagKey, createdAt])
  @@index([actorId, createdAt])
}

model AdminSettingChange {
  id          String   @id @default(cuid())
  settingKey  String
  actorId     String
  before      String?
  after       String?
  reason      String?
  createdAt   DateTime @default(now())

  @@index([settingKey, createdAt])
  @@index([actorId, createdAt])
}

model AdminAuditEvent {
  id          String   @id @default(cuid())
  actorId     String?
  actorRole   String?
  action      String
  resource    String
  resourceId  String?
  caseId      String?
  reason      String?
  permission  String?
  outcome     String   @default("SUCCESS")
  riskLevel   String   @default("LOW")
  before      String?
  after       String?
  ipAddress   String?
  userAgent   String?
  sessionId   String?
  createdAt   DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([resource, resourceId, createdAt])
  @@index([caseId, createdAt])
  @@index([riskLevel, createdAt])
  @@index([outcome, createdAt])
}


enum ManagedDeviceStatus {
  PENDING
  ACTIVE
  OFFLINE
  NON_COMPLIANT
  REVOKED
}

enum DeviceCommandStatus {
  PENDING
  SENT
  SUCCEEDED
  FAILED
  EXPIRED
}

model ManagedDevice {
  id                    String              @id @default(cuid())
  userId                String
  deviceId              String              @unique
  deviceName            String?
  manufacturer          String?
  model                 String?
  androidVersion        String?
  sdkInt                Int?
  appVersion            String?
  status                ManagedDeviceStatus  @default(PENDING)
  isDeviceOwner         Boolean             @default(false)
  isProfileOwner        Boolean             @default(false)
  lastSeenAt            DateTime?
  enrolledAt            DateTime            @default(now())
  revokedAt             DateTime?

  owner                 User                @relation("DeviceOwner", fields: [userId], references: [id], onDelete: Cascade)
  applications          InstalledApplication[]
  policyAssignments     DevicePolicyAssignment[]
  commands              DeviceCommand[]
  inventorySnapshots    DeviceInventorySnapshot[]
  managementAudits      DeviceManagementAudit[]

  @@index([userId, status])
  @@index([status, lastSeenAt])
}

model InstalledApplication {
  id                  String        @id @default(cuid())
  deviceId            String
  packageName         String
  appName             String
  versionName         String?
  versionCode         String?
  isSystemApp         Boolean       @default(false)
  isManaged            Boolean       @default(false)
  policyState         String        @default("UNMANAGED")
  installedAt         DateTime?
  updatedAt            DateTime?
  firstSeenAt          DateTime      @default(now())
  lastSeenAt           DateTime      @default(now())

  device              ManagedDevice  @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([deviceId, packageName])
  @@index([deviceId, policyState])
  @@index([packageName])
}

model DevicePolicy {
  id                    String          @id @default(cuid())
  name                  String
  description           String?
  allowedPackages       String?
  blockedPackages       String?
  requiredPackages      String?
  minimumVersions       String?
  enabled               Boolean         @default(true)
  createdById            String
  updatedById            String?
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  createdBy              User            @relation("DevicePolicyActor", fields: [createdById], references: [id], onDelete: Cascade)
  assignments            DevicePolicyAssignment[]

  @@index([enabled, updatedAt])
  @@index([createdById, createdAt])
}

model DevicePolicyAssignment {
  id                  String        @id @default(cuid())
  deviceId            String
  policyId            String
  assignedAt          DateTime      @default(now())
  revokedAt           DateTime?

  device              ManagedDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  policy              DevicePolicy  @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@unique([deviceId, policyId])
  @@index([deviceId, revokedAt])
  @@index([policyId, revokedAt])
}

model DeviceCommand {
  id            String             @id @default(cuid())
  deviceId      String
  requestedById String
  action        String
  payload       String?
  status        DeviceCommandStatus @default(PENDING)
  expiresAt     DateTime?
  createdAt     DateTime            @default(now())
  completedAt   DateTime?

  device        ManagedDevice      @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  results       DeviceCommandResult[]

  @@index([deviceId, status, createdAt])
  @@index([requestedById, createdAt])
}

model DeviceCommandResult {
  id          String              @id @default(cuid())
  commandId   String
  status      DeviceCommandStatus
  message     String?
  createdAt   DateTime            @default(now())

  command     DeviceCommand        @relation(fields: [commandId], references: [id], onDelete: Cascade)

  @@index([commandId, createdAt])
}

model DeviceInventorySnapshot {
  id          String        @id @default(cuid())
  deviceId    String
  capturedAt  DateTime      @default(now())
  appCount    Int           @default(0)
  payload     String?

  device      ManagedDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId, capturedAt])
}

model DeviceManagementAudit {
  id          String        @id @default(cuid())
  deviceId    String?
  actorId     String?
  action      String
  resource    String
  resourceId  String?
  outcome     String        @default("SUCCESS")
  details     String?
  createdAt   DateTime      @default(now())

  device      ManagedDevice? @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  actor       User?         @relation("DeviceManagementAuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([deviceId, createdAt])
  @@index([actorId, createdAt])
  @@index([resource, resourceId, createdAt])
}
