{
  "name": "socialhub",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/ensure-production-schema.mjs && prisma generate && next build",
    "start": "next start",
    "typecheck": "prisma generate && tsc --noEmit",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:push": "prisma db push",
    "build:ci": "prisma generate && next build",
    "build:with-migrations": "prisma migrate deploy && prisma generate && next build",
    "test": "node --test tests/*.test.mjs",
    "lint": "eslint ."
  },
  "dependencies": {
    "lucide-react": "1.48.0",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "@prisma/client": "7.10.0",
    "@prisma/adapter-pg": "7.10.0",
    "@vercel/blob": "2.8.0",
    "pg": "8.23.1",
    "dotenv": "17.2.2",
    "better-auth": "1.7.7",
    "@better-auth/prisma-adapter": "1.7.6",
    "nodemailer": "10.0.12",
    "zod": "4.6.5",
    "@better-auth/expo": "1.7.7",
    "livekit-server-sdk": "2.19.1"
  },
  "devDependencies": {
    "@types/node": "24.7.2",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@tailwindcss/postcss": "4.1.14",
    "postcss": "8.5.6",
    "tailwindcss": "4.1.14",
    "typescript": "5.9.3",
    "prisma": "7.10.0",
    "@types/pg": "8.15.5",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.8"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "type": "module"
}
