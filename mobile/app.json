{
  "expo": {
    "name": "SocialHub",
    "slug": "socialhub",
    "version": "1.0.3",
    "orientation": "portrait",
    "scheme": "socialhub",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.socialhub.app",
      "versionCode": 4,
      "adaptiveIcon": {
        "backgroundColor": "#0b0b0f"
      },
      "backgroundColor": "#08080c",
      "icon": "./assets/icon.png",
      "softwareKeyboardLayoutMode": "resize"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "microphonePermission": false
        }
      ],
      [
        "expo-video",
        {
          "supportsPictureInPicture": true
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#725cff",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#08080c",
          "image": "./assets/icon.png",
          "imageWidth": 180,
          "resizeMode": "contain"
        }
      ]
    ],
    "extra": {
      "apiBaseUrl": "https://socialhub-ruby.vercel.app"
    },
    "backgroundColor": "#08080c",
    "androidStatusBar": {
      "barStyle": "light-content",
      "backgroundColor": "#08080c",
      "translucent": true
    },
    "icon": "./assets/icon.png"
  }
}
