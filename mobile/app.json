{
  "expo": {
    "name": "SocialHub",
    "slug": "socialhub",
    "version": "1.0.3",
    "orientation": "portrait",
    "scheme": "socialhub",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.socialhub.app",
      "versionCode": 4,
      "adaptiveIcon": {
        "backgroundColor": "#6d5dfc"
      },
      "backgroundColor": "#08080c",
      "icon": "./assets/icon.png",
      "softwareKeyboardLayoutMode": "resize"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Socialhub uses your photos and videos only when you choose media to post or share.",
          "cameraPermission": "Socialhub uses your camera only when you choose to capture media.",
          "microphonePermission": false
        }
      ],
      [
        "expo-video",
        {
          "supportsPictureInPicture": true
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#08080c",
          "image": "./assets/icon.png",
          "imageWidth": 180,
          "resizeMode": "contain"
        }
      ]
    ],
    "extra": {
      "apiBaseUrl": "https://socialhublive.vercel.app"
    },
    "backgroundColor": "#08080c",
    "icon": "./assets/icon.png"
  }
}
