{
  "expo": {
    "name": "SocialHub",
    "slug": "socialhub",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "socialhub",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.socialhub.app",
      "versionCode": 2,
      "adaptiveIcon": {
        "backgroundColor": "#0b0b0f"
      },
      "backgroundColor": "#08080c"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "microphonePermission": false
        }
      ]
    ],
    "extra": {
      "apiBaseUrl": "https://socialhub-ruby.vercel.app"
    },
    "backgroundColor": "#08080c",
    "androidStatusBar": {
      "barStyle": "light-content",
      "backgroundColor": "#08080c",
      "translucent": true
    },
    "androidNavigationBar": {
      "barStyle": "light-content",
      "backgroundColor": "#08080c",
      "contrastEnforced": false
    }
  }
}
