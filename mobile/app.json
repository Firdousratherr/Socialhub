{
  "expo": {
    "name": "SocialHub",
    "slug": "socialhub",
    "version": "1.0.5",
    "orientation": "portrait",
    "scheme": "socialhub",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.socialhub.app",
      "versionCode": 6,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#08080c"
      },
      "backgroundColor": "#08080c",
      "icon": "./assets/icon.png",
      "softwareKeyboardLayoutMode": "resize"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Socialhub uses your photos and videos only when you choose media to post or share.",
          "cameraPermission": "Socialhub uses the camera only when you choose to take a photo or video.",
          "microphonePermission": "Socialhub uses the microphone only when you choose to record or make a call."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Socialhub uses the camera only when you choose to take a photo, video, or join a video call.",
          "microphonePermission": "Socialhub uses the microphone only when you choose to record or join a call.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Socialhub uses the microphone only when you choose to record audio or join a call.",
          "recordAudioAndroid": true,
          "enableBackgroundRecording": false
        }
      ],
      "expo-document-picker",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#725cff",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-video",
        {
          "supportsPictureInPicture": true
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#08080c",
          "image": "./assets/icon.png",
          "imageWidth": 180,
          "resizeMode": "contain"
        }
      ]
    ],
    "extra": {
      "apiBaseUrl": "https://socialhublive.vercel.app"
    },
    "backgroundColor": "#08080c",
    "androidStatusBar": {
      "barStyle": "light-content",
      "backgroundColor": "#08080c",
      "translucent": true
    },
    "icon": "./assets/icon.png"
  }
}