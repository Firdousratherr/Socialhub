{
  "expo": {
    "name": "SocialHub",
    "slug": "socialhub",
    "version": "1.1.0",
    "orientation": "portrait",
    "scheme": "socialhub",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.socialhub.app",
      "versionCode": 11,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#F6F7FB"
      },
      "backgroundColor": "#08080c",
      "icon": "./assets/icon.png",
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "RECORD_AUDIO",
        "CAMERA",
        "BLUETOOTH_CONNECT",
        "BLUETOOTH_SCAN",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_MICROPHONE",
        "FOREGROUND_SERVICE_CAMERA",
        "POST_NOTIFICATIONS"
      ]
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-status-bar",
        {
          "style": "dark"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Socialhub uses your photos and videos only when you choose media to post or share.",
          "cameraPermission": "Socialhub uses the camera only when you choose to take a photo or video.",
          "microphonePermission": "Socialhub uses the microphone only when you choose to record or make a call."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Socialhub uses the camera only when you choose to take a photo, video, or join a video call.",
          "microphonePermission": "Socialhub uses the microphone only when you choose to record or join a call.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Socialhub uses the microphone only when you choose to record audio or join a call.",
          "recordAudioAndroid": true,
          "enableBackgroundRecording": false
        }
      ],
      "expo-document-picker",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#5A4BE8",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-video",
        {
          "supportsPictureInPicture": true
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F6F7FB",
          "image": "./assets/icon.png",
          "imageWidth": 180,
          "resizeMode": "contain"
        }
      ],
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "Socialhub uses the camera only when you choose to make or join a video call.",
          "microphonePermission": "Socialhub uses the microphone only when you choose to make or join a voice or video call."
        }
      ]
    ],
    "extra": {
      "apiBaseUrl": "https://socialhublive.vercel.app"
    },
    "backgroundColor": "#08080c",
    "icon": "./assets/icon.png"
  }
}
