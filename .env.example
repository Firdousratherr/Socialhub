# PostgreSQL
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/socialhub?schema=public"

# Better Auth
BETTER_AUTH_SECRET="replace-with-a-long-random-secret"
BETTER_AUTH_URL="http://localhost:3000"

# Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# SMTP
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""

# Vercel Blob
BLOB_READ_WRITE_TOKEN=""

# Administrator login
# These credentials are server-side only and are never exposed to the browser.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="replace-with-a-long-random-password"
ADMIN_NAME="Administrator"


# Set to true only when Google OAuth credentials are configured.
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED="false"

# Upload quota
MAX_DAILY_UPLOAD_BYTES="26214400"

# Protected cron jobs
CRON_SECRET="replace-with-a-long-random-cron-secret"
